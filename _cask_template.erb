cask "terraform-<%= cask_version %>" do
  <%- if cask_builds.length == 1 -%>
  version "<%= version %>"
  sha256 <%= cask_builds.first.sha256.inspect %>

  url "https://releases.hashicorp.com/terraform/#{version}/terraform_#{version}_darwin_<%= cask_builds.first.arch %>.zip"
  <%- else -%>
  <%- sorted = cask_builds.sort_by(&:cask_arch) -%>
  <%- width = sorted.map { |build| build.cask_arch.length }.max + 1 -%>
  arch <%= sorted.map { |build| "#{build.cask_arch}: #{build.arch.inspect}" }.join(", ") %>

  version "<%= version %>"
  sha256 <%= sorted.map { |build| "#{"#{build.cask_arch}:".ljust(width)} #{build.sha256.inspect}" }.join(",\n         ") %>

  url "https://releases.hashicorp.com/terraform/#{version}/terraform_#{version}_darwin_#{arch}.zip"
  <%- end -%>
  name "Terraform"
  homepage "https://www.terraform.io/"

  # Binaries not installed as multiple versions are expected to coexist.
  # Normally the wanted version is selected with `chtf`.
  stage_only true
end
